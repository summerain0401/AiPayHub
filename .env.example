# ===========================================
# AI-Pay Hub 环境配置
# ===========================================

# 服务端口
PORT=3000

# Redis 连接 (用于订单状态机)
REDIS_URL=redis://localhost:6379

# 网关公开地址 (用于 webhook 回调和 OpenAPI schema)
GATEWAY_BASE_URL=http://localhost:3000

# 网关内部签名密钥 (随机生成, 32位hex)
WEBHOOK_SECRET=your_random_webhook_secret_here

# ===========================================
# 支付宝 AI 支付 (alipay-sdk + RSA2 签名)
# 沙箱环境: https://openhome.alipay.com/develop/sandbox/app
# ===========================================
ALIPAY_APP_ID=
# 应用私钥 (PKCS8, 单行, \n 表示换行)
ALIPAY_PRIVATE_KEY=
# 支付宝公钥
ALIPAY_PUBLIC_KEY=
# 沙箱网关
ALIPAY_GATEWAY=https://openapi.alipaydev.com/gateway.do

# 价格档位 → AI Pay Service ID 映射 (最多 10 个)
# 格式: ALIPAY_TIER_{tier_id}={service_id}
# ALIPAY_TIER_tier_050=svc_xxxxxxxx
# ALIPAY_TIER_tier_100=svc_xxxxxxxx

# ===========================================
# 限流配置
# ===========================================
# 每 IP 每分钟最大请求数
RATE_LIMIT_RPM=100
